{
  "version": "v1_rules_weighted",
  "description": "Scoring basado en reglas y ponderaciones definidas desde análisis. Devuelve score 0-100 con base 50 y aportes +/- por variable.",
  "score": {
    "base": 50,
    "clip": { "min": 0, "max": 100 }
  },
  "weights": {
    "localidad": 40,
    "hora_registro": 30,
    "edad": 20,
    "tipo_afiliacion": 10
  },
  "rules": {
    "localidad": {
      "normalize": {
        "uppercase": true,
        "strip": true,
        "remove_dots": true,
        "aliases": {
          "CAPITAL FEDERAL": "CABA",
          "CAP FED": "CABA",
          "C A B A": "CABA",
          "C.A.B.A": "CABA",
          "CIUDAD AUTONOMA DE BUENOS AIRES": "CABA",
          "CIUDAD AUTÓNOMA DE BUENOS AIRES": "CABA",
          "GRAL SAN MARTIN": "GRAL SAN MARTÍN",
          "LANUS": "LANÚS",
          "OTRA": "OTRAS",
          "OTRO": "OTRAS",
          "OTRAS": "OTRAS"
        }
      },
      "groups": [
        {
          "name": "alta",
          "score": 40,
          "localidades": ["TRES DE FEBRERO", "VICENTE LÓPEZ", "VICENTE LOPEZ", "MORÓN", "MORON", "MERLO", "BERAZATEGUI", "CABA", "LA MATANZA"]
        },
        {
          "name": "media_alta",
          "score": 30,
          "localidades": ["QUILMES", "SAN FERNANDO"]
        },
        {
          "name": "media",
          "score": 20,
          "localidades": ["LOMAS DE ZAMORA", "SAN ISIDRO", "GRAL SAN MARTÍN", "GRAL SAN MARTIN", "TIGRE", "ALMIRANTE BROWN", "LANÚS", "LANUS"]
        },
        {
          "name": "baja",
          "score": -20,
          "localidades": ["PILAR", "FLORENCIO VARELA", "ITUZAINGÓ", "ITUZAINGO", "ESTEBAN ECHEVERRÍA", "ESTEBAN ECHEVERRRIA", "CAMPANA", "EZEIZA", "ZÁRATE", "ZARATE"]
        },
        {
          "name": "muy_baja",
          "score": -40,
          "localidades": ["OTRAS"]
        }
      ],
      "default_score": 0
    },
    "hora_registro": {
      "source_fields": ["Hora", "Fecha Registro", "FechaRegistro", "Fecha Registro/Hora", "fecha_registro", "hora"],
      "bins": [
        { "name": "muy_favorable", "score": 30, "start": 13, "end": 16 },
        { "name": "favorable", "score": 20, "start": 9, "end": 12 },
        { "name": "neutra", "score": 0, "start": 17, "end": 20 },
        { "name": "desfavorable", "score": -10, "start": 21, "end": 23 },
        { "name": "muy_desfavorable", "score": -20, "start": 0, "end": 8 }
      ],
      "default_score": 0
    },
    "edad": {
      "bins": [
        { "name": "alta_40_49", "score": 20, "min": 40, "max": 49 },
        { "name": "alta_50_plus", "score": 20, "min": 50, "max": 200 },
        { "name": "media_25_29", "score": 10, "min": 25, "max": 29 },
        { "name": "baja_30_34", "score": -10, "min": 30, "max": 34 },
        { "name": "neutra", "score": 0, "min": 0, "max": 200 }
      ],
      "default_score": 0
    },
    "tipo_afiliacion": {
      "normalize": { "lowercase": true, "strip": true },
      "mapping": [
        { "name": "favorable_monotributo", "score": 10, "contains_any": ["monotrib"] },
        { "name": "desfavorable_recibo", "score": -10, "contains_any": ["recibo"] },
        { "name": "neutra_particular_autonomo", "score": 0, "contains_any": ["particular", "autonom"] }
      ],
      "default_score": 0
    },
    "estado": {
      "mapping": [
        { "name": "venta",                 "score": 20, "values": ["Venta"] },
        { "name": "calificado_pago",        "score": 15, "values": ["Calificado Pago"] },
        { "name": "calificado_poliza",      "score": 12, "values": ["Calificado P\u00f3liza"] },
        { "name": "calificado_cotizacion",  "score": 8,  "values": ["Calificado Cotizaci\u00f3n"] },
        { "name": "primer_contacto",        "score": 4,  "values": ["1\u00ba Contacto"] },
        { "name": "lead",                   "score": 0,  "values": ["Lead"] },
        { "name": "descartado",             "score": -15, "values": ["Fuera de zona", "Fuera de edad", "No le interesa (econ\u00f3mico)", "No le interesa cartilla", "No busca cobertura m\u00e9dica", "Tel\u00e9fono err\u00f3neo", "Preexistencia"] }
      ],
      "default_score": 0
    }
  },
  "classification": [
    { "label": "Alta",    "min": 70, "max": 100 },
    { "label": "Buena",   "min": 40, "max": 69 },
    { "label": "Regular", "min": 0,  "max": 39 }
  ],
  "notes": [
    "Score = base(50) + aporte_localidad + aporte_hora + aporte_edad + aporte_tipo_af + aporte_estado. Luego se clampa a 0-100."
  ]
}
